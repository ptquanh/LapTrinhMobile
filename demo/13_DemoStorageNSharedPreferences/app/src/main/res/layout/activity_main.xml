<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:paddingTop="36dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEMO STORAGE &amp; SHARED PREFERENCES"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 1. Internal Storage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Internal Storage"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/teal_700"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/writeIS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Ghi Internal" />

            <Button
                android:id="@+id/readIS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đọc Internal" />
        </LinearLayout>

        <!-- 2. External Storage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. External Storage (App-specific)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/teal_700"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/writeES"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Ghi External" />

            <Button
                android:id="@+id/readES"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đọc External" />
        </LinearLayout>

        <!-- 3. Cache Storage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Cache Storage"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/teal_700"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/writeCF"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Ghi Cache" />

            <Button
                android:id="@+id/readCF"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đọc Cache" />
        </LinearLayout>

        <!-- 4. SharedPreferences -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. SharedPreferences"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#E91E63"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/edPrefKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập Key (ví dụ: username)" />

        <EditText
            android:id="@+id/edPrefValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập Value (ví dụ: JohnDoe)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSavePref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Lưu SP" />

            <Button
                android:id="@+id/btnReadPref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Đọc SP" />

            <Button
                android:id="@+id/btnClearPref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xóa SP" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrefResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kết quả SharedPreferences: (chưa có)"
            android:textSize="15sp"
            android:textColor="@color/black" />

    </LinearLayout>
</ScrollView>
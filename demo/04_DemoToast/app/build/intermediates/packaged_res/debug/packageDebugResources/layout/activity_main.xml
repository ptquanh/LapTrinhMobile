<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEMO TOAST - 3 METHODS"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnMethod1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="showToastXml"
        android:layout_marginBottom="16dp"
        android:text="Method 1: XML onClick" />

    <Button
        android:id="@+id/btnMethod2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Method 2: implements OnClickListener" />

    <Button
        android:id="@+id/btnMethod3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Method 3: Anonymous Listener" />

</LinearLayout>
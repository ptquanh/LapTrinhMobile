<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_forecast_item"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/txtTimeForecast"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="@string/sample_time"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgForecast"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/desc_forecast_weather_icon"
        android:src="@drawable/ic_weather_cloud_sun"
        tools:src="@drawable/ic_weather_cloud_sun" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTemperatureForecast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sample_temp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtWindForecast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/sample_wind"
            android:textColor="@color/sky_primary_dark"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>


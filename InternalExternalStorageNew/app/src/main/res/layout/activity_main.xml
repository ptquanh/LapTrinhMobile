<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="126dp"
            android:layout_height="match_parent"
            android:src="@drawable/logo_ptit" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Học viện Công nghệ Bưu chính Viễn thông"
            android:textColor="#FF0000"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="8dp" />
    </LinearLayout>

    <Button
        android:id="@+id/writeIS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:textSize="30dp"
        android:background="@drawable/button_shape"
        app:backgroundTint="@null"
        android:text="write internal storage" />

    <Button
        android:id="@+id/readIS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:textSize="30dp"
        android:background="@drawable/button_shape"
        app:backgroundTint="@null"
        android:text="read internal storage" />

    <Button
        android:id="@+id/writeCF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:textSize="30dp"
        android:background="@drawable/button_shape"
        app:backgroundTint="@null"
        android:text="write cache file" />

    <Button
        android:id="@+id/readCF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:textSize="30dp"
        android:background="@drawable/button_shape"
        app:backgroundTint="@null"
        android:text="read cache file" />

    <Button
        android:id="@+id/writeES"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:textSize="30dp"
        android:background="@drawable/button_shape"
        app:backgroundTint="@null"
        android:text="write external storage" />

    <Button
        android:id="@+id/readES"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:textSize="30dp"
        android:background="@drawable/button_shape"
        app:backgroundTint="@null"
        android:text="read external storage" />
</LinearLayout>